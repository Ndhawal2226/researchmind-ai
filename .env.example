# Copy this file to .env; NEVER commit your filled .env
APP_NAME="ResearchMind AI"
APP_ENV=development
LOG_LEVEL=INFO

# xAI API credentials (the consumer Grok chat service is not the same as API access)
XAI_API_KEY=
# Set to an actual model available in your xAI account before Phase 7
XAI_MODEL=

# Pinecone credentials / index (do not create an index before deciding hybrid schema)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=researchmind-hybrid
PINECONE_NAMESPACE=development
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Local embedding model; dimensions must match Pinecone index
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval defaults (will be tuned/evaluated in Phase 6)
DENSE_TOP_K=20
SPARSE_TOP_K=20
FINAL_TOP_K=5

# File processing limits
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_PAGES=150
